DATABASE_URL="postgresql://lexroom:lexroom@localhost:5432/lexroom?schema=public&connection_limit=20"

# Optional simulation controls. Defaults match the exercise:
# 60s deadline, about 1 in 5 explicit failures, about 1 in 10 slow runs,
# normal completion between 5 and 30 seconds.
# REVIEW_TIMEOUT_MS=60000
# REVIEW_FAIL_RATE=0.2
# REVIEW_SLOW_RATE=0.1
# REVIEW_DURATION_MIN_MS=5000
# REVIEW_DURATION_MAX_MS=30000
# REVIEW_SLOW_MIN_MS=60000
# REVIEW_SLOW_MAX_MS=120000
# WORKER_INTERVAL_MS=500
