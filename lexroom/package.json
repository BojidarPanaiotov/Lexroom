{
  "name": "lexroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db": "tsx --env-file=.env scripts/postgres.ts",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "tsx --test lib/*.test.ts",
    "verify": "tsx --env-file=.env scripts/verify.ts",
    "app": "concurrently -n db,web,worker \"npm run db\" \"npm run dev\" \"npm run worker\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "concurrently": "^10.0.6",
    "next": "16.4.0",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
